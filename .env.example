# Copy to .env. A fresh clone runs with none of these set.

# --- Local mode ---
# Replace the model and outside APIs with recorded fixtures.
MOCK_AGENT=1
# Render every card as a text-only title card.
POSTERS=on
# Port for `pnpm dev:local`.
PORT=8787
# The number shown on the pairing screen in local mode.
RECCO_PHONE_NUMBER=+13322201535
# Salt for phone number hashing. Any long random string.
PHONE_HASH_SALT=change-me-local-only

# --- AWS (Milestone 4) ---
AWS_REGION=us-east-1
TABLE_NAME=
APPSYNC_EVENTS_HTTP_DOMAIN=
APPSYNC_EVENTS_REALTIME_DOMAIN=
APPSYNC_EVENTS_API_KEY=

# --- SMS providers ---
SMS_PROVIDER=simulator   # simulator | aws | zernio
# Signs calls to POST /webhooks/sms (x-recco-signature: t=<unix>,v1=<hmac-sha256 of "t.body">).
SMS_WEBHOOK_SECRET=local-webhook-secret
ZERNIO_API_KEY=
# Set the same value as the secret on the Zernio webhook (X-Zernio-Signature).
ZERNIO_WEBHOOK_SECRET=

# --- Outside data (stored in Secrets Manager when deployed) ---
OMDB_API_KEY=
SCRAPECREATORS_API_KEY=
# Reads any other link (articles, IMDb, Letterboxd) through Jina Reader (r.jina.ai).
JINA_API_KEY=

# --- Agent (Vercel AI SDK + AI Gateway; see services/recco-agent/src/model.ts) ---
# Set MOCK_AGENT=0 above and add a gateway key to use the real agent.
AI_GATEWAY_API_KEY=
# Any AI Gateway model id. amazon/nova-2-lite also works.
RECCO_MODEL=anthropic/claude-haiku-5.5
AGENTCORE_RUNTIME_ARN=
